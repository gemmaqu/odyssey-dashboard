{
  "openapi": "3.1.0",
  "info": {
    "title": "Odyssey Ordering API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCents": {
            "type": "number"
          },
          "isAvailable": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "priceCents",
          "isAvailable",
          "createdAt"
        ]
      },
      "MenuCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder",
          "createdAt"
        ]
      },
      "MenuCategoryWithItems": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MenuCategory"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            },
            "required": [
              "items"
            ]
          }
        ]
      },
      "CreateMenuCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "validation_error"
              },
              "message": {
                "type": "string",
                "example": "Order must contain at least one item."
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "isAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "categoryId",
          "name",
          "priceCents"
        ]
      },
      "UpdateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "isAvailable": {
            "type": "boolean"
          }
        }
      },
      "OrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "subtotalCents": {
            "type": "number"
          },
          "taxCents": {
            "type": "number"
          },
          "totalCents": {
            "type": "number"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "customerName": {
            "type": "string"
          },
          "itemCount": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "subtotalCents",
          "taxCents",
          "totalCents",
          "notes",
          "createdAt",
          "updatedAt",
          "customerName",
          "itemCount"
        ]
      },
      "OrderListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "total",
          "limit",
          "offset"
        ]
      },
      "OrderCustomerRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "nameSnapshot": {
            "type": "string"
          },
          "unitPriceCents": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "lineTotalCents": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "orderId",
          "menuItemId",
          "nameSnapshot",
          "unitPriceCents",
          "quantity",
          "lineTotalCents"
        ]
      },
      "OrderDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "subtotalCents": {
            "type": "number"
          },
          "taxCents": {
            "type": "number"
          },
          "totalCents": {
            "type": "number"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "customer": {
            "$ref": "#/components/schemas/OrderCustomerRef"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "availableActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "accept",
                "start_preparing",
                "mark_ready",
                "complete",
                "cancel"
              ]
            }
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "subtotalCents",
          "taxCents",
          "totalCents",
          "notes",
          "createdAt",
          "updatedAt",
          "customer",
          "items",
          "availableActions"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "menuItemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 99
                }
              },
              "required": [
                "menuItemId",
                "quantity"
              ]
            },
            "minItems": 1
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "required": [
          "customerId",
          "items"
        ]
      },
      "OrderTransition": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "start_preparing",
              "mark_ready",
              "complete",
              "cancel"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "createdAt"
        ]
      },
      "CustomerSummary": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Customer"
          },
          {
            "type": "object",
            "properties": {
              "orderCount": {
                "type": "integer"
              },
              "totalSpentCents": {
                "type": "integer"
              },
              "lastOrderAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "orderCount",
              "totalSpentCents",
              "lastOrderAt"
            ]
          }
        ]
      },
      "CreateCustomer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "CustomerDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerSummary"
          },
          {
            "type": "object",
            "properties": {
              "recentOrders": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderSummary"
                }
              }
            },
            "required": [
              "recentOrders"
            ]
          }
        ]
      },
      "OpeningHour": {
        "type": "object",
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "open": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "close": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "closed": {
            "type": "boolean"
          }
        },
        "required": [
          "day",
          "open",
          "close",
          "closed"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prepTimeMinutes": {
            "type": "number"
          },
          "autoAccept": {
            "type": "boolean"
          },
          "serviceOpen": {
            "type": "boolean"
          },
          "taxRateBps": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "openingHours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpeningHour"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "prepTimeMinutes",
          "autoAccept",
          "serviceOpen",
          "taxRateBps",
          "currency",
          "openingHours",
          "updatedAt"
        ]
      },
      "UpdateSettings": {
        "type": "object",
        "properties": {
          "prepTimeMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          },
          "autoAccept": {
            "type": "boolean"
          },
          "serviceOpen": {
            "type": "boolean"
          },
          "taxRateBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "openingHours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpeningHour"
            }
          }
        }
      },
      "PopularItem": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "revenueCents": {
            "type": "integer"
          }
        },
        "required": [
          "menuItemId",
          "name",
          "quantity",
          "revenueCents"
        ]
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "totalOrders": {
            "type": "integer"
          },
          "revenueCents": {
            "type": "integer"
          },
          "pendingOrders": {
            "type": "integer"
          },
          "activeOrders": {
            "type": "integer"
          },
          "completedOrders": {
            "type": "integer"
          },
          "avgOrderValueCents": {
            "type": "integer"
          },
          "popularItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PopularItem"
            }
          },
          "recentOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            }
          }
        },
        "required": [
          "totalOrders",
          "revenueCents",
          "pendingOrders",
          "activeOrders",
          "completedOrders",
          "avgOrderValueCents",
          "popularItems",
          "recentOrders"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/menu": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "List categories with their items",
        "responses": {
          "200": {
            "description": "Menu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MenuCategoryWithItems"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/menu/categories": {
      "post": {
        "tags": [
          "Menu"
        ],
        "summary": "Create a category",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuCategory"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuCategoryWithItems"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items": {
      "post": {
        "tags": [
          "Menu"
        ],
        "summary": "Create a menu item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items/{id}": {
      "patch": {
        "tags": [
          "Menu"
        ],
        "summary": "Update a menu item (price, availability, …)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List and filter orders",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "customerId",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create an order (totals computed server-side)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "An item is unknown or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get order detail",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}/transitions": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Advance an order through a valid status transition",
        "description": "Status changes go through the shared state machine. Illegal transitions are rejected with 409.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderTransition"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Illegal transition for the current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/customers": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "List customers with order count and spend",
        "responses": {
          "200": {
            "description": "Customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CustomerSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
