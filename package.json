{
  "name": "odyssey-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=@odyssey/dashboard",
    "dev:backend": "turbo run dev --filter=@odyssey/backend",
    "gen:contract": "turbo run gen:contract --filter=@odyssey/backend && turbo run gen:client --filter=@odyssey/api-client",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "turbo run db:migrate --filter=@odyssey/backend",
    "db:seed": "turbo run db:seed --filter=@odyssey/backend",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && pnpm db:migrate && pnpm db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
